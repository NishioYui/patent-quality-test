{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecOnlyDraftV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification", "warnings", "metadata"],
  "properties": {
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_name",
        "invention_title",
        "technical_field",
        "background_art",
        "prior_art_literature",
        "patent_documents",
        "summary_of_invention",
        "problem_to_be_solved",
        "means_for_solving",
        "effect_of_invention",
        "drawings",
        "mode_for_carrying_out",
        "reference_signs",
        "formatted_text"
      ],
      "properties": {
        "document_name": { "type": "string", "const": "明細書" },

        "invention_title": { "type": "string" },
        "technical_field": { "type": "string" },
        "background_art": { "type": "string" },

        "prior_art_literature": { "type": "string" },

        "patent_documents": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "citation"],
            "properties": {
              "label": { "type": "string" },
              "citation": { "type": "string" }
            }
          }
        },

        "summary_of_invention": { "type": "string" },
        "problem_to_be_solved": { "type": "string" },
        "means_for_solving": { "type": "string" },
        "effect_of_invention": { "type": "string" },

        "drawings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description"],
            "properties": {
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },

        "mode_for_carrying_out": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preface", "configuration", "operation", "effect", "modifications_note"],
          "properties": {
            "preface": { "type": "string" },
            "configuration": { "type": "string" },
            "operation": { "type": "string" },
            "effect": { "type": "string" },
            "modifications_note": { "type": "string" }
          }
        },

        "reference_signs": { "type": "string" },

        "formatted_text": { "type": "string" }
      }
    },

    "warnings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "evidence"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "TERM_INCONSISTENCY",
              "SUPPORT_LACKING",
              "UNIT_OR_RANGE_CONFLICT"
            ]
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "message": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "location"],
              "properties": {
                "quote": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "temperature", "prompt_version", "run_id", "language"],
      "properties": {
        "model": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "prompt_version": { "type": "string" },
        "run_id": { "type": "string" },
        "language": { "type": "string", "const": "ja" }
      }
    }
  }
}
